<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	</array>
	<!-- Required for APNs registration. Without this key iOS refuses to
	     register for remote notifications, Firebase never receives an APNs
	     token, and FCM therefore never issues a token to send pushes to.
	     Xcode automatically rewrites this to "production" for Release/
	     TestFlight/App Store builds. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
